#!/bin/bash
# Regenerates the app icon and the logo images from logo.svg (see make_logo.py).
set -euo pipefail
cd "$(dirname "$0")"

python3 make_logo.py

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
sips -s format png logo.svg --out "$tmp/1024.png" >/dev/null

iconset="$tmp/TextMate.iconset"
mkdir "$iconset"
for size in 16 32 128 256 512; do
	sips -z $size $size "$tmp/1024.png" --out "$iconset/icon_${size}x${size}.png" >/dev/null
	sips -z $((size * 2)) $((size * 2)) "$tmp/1024.png" --out "$iconset/icon_${size}x${size}@2x.png" >/dev/null
done
iconutil --convert icns --output ../TextMate.icns "$iconset"

sips -z 256 256 "$tmp/1024.png" --out ../../about/images/icon.png >/dev/null   # About window
sips -z 512 512 "$tmp/1024.png" --out logo.png >/dev/null                      # README
echo "Wrote ../TextMate.icns, ../../about/images/icon.png and logo.png"
